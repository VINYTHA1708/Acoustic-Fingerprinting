@@ -93,12 +93,20 @@ _STD_FLOOR = 1e-10   # matches LearnedDriftMetrics and final_method_config.json
 # ---------------------------------------------------------------------------
 
 def _roc_auc(y_true: np.ndarray, scores: np.ndarray) -> float:
+    """ROC-AUC with a FIXED score direction (higher score = more anomalous).
+
+    NOTE (correctness): earlier revisions reversed the score direction whenever
+    the computed AUC fell below 0.5.  That reversal chooses the score direction
+    using the test labels, so a detector with no discriminative ability is
+    reported above chance (e.g. a raw AUC of 0.3811 was reported as 0.6189).
+    The anomaly score D is defined so that larger values mean greater deviation
+    from the healthy reference, and that direction is fixed a priori; it must
+    not be re-chosen per scope.  An AUC below 0.5 is a real, reportable outcome
+    meaning the score carries no usable signal in that scope.
+    """
     from sklearn.metrics import roc_auc_score
     try:
-        auc = float(roc_auc_score(y_true, scores))
-        if not np.isnan(auc) and auc < 0.5:
-            auc = float(roc_auc_score(y_true, -scores))
-        return auc
+        return float(roc_auc_score(y_true, scores))
     except Exception:
         return float("nan")
 
